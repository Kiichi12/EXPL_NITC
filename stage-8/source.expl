type
  List
  {
    int data;
    List next;
  }
endtype

decl
    List head;
enddecl

int main()
{
  decl
    int length, x;
    List p, q;
  enddecl

  begin
    initialize();

    head=NULL;
    q=head;
    read(x);
    while (x!=0)  do
      p=alloc();
      p.data=x;
      p.next=NULL;

      if (head==NULL) then
        head=p;
        q=p;
      else
        q.next=p;
        q=p;
      endif;
      read(x);
    endwhile;

    p=head;
    while(p!=NULL)  do
      write(p.data);
      p=p.next;
    endwhile;

    return 1;
  end
}