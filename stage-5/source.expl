decl
    int swap(*int x, *int y);
    int factorial(int n);
enddecl

int factorial(int n)
{
    decl
        int result;
    enddecl
    begin
        if(n == 0) then
            result = 1;
        else
            result = n * factorial(n-1);
        endif;
        return result;
    end
}

int swap(*int x, *int y)
{
    decl
        int temp;
    enddecl
    begin
        temp = *x;
        *x = *y;
        *y = temp;
        return 0;  
        write("after return") ;
    end
}

int main(){
    decl
        int x;
        int y;
        int a;
    enddecl
    begin
        read(x);
        read(y);
        a = swap(&x, &y);
        write(a);
        write(x);
        write(y);
        return 0;
    end
}
