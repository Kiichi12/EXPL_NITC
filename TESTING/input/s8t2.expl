class A
{
    decl
        int f0();
        int f1();
    enddecl

    int f0()
    {
        begin
            write("In A F0");
            return 1;
        end
    }

    int f1()
    {
        begin
            write("In A F1");
            return 1;
        end
    }
}

B extends A
{
    decl
        int f0();
        int f2();
    enddecl

    int f0()
    {
        begin
            write("In B F0");
            return 1;
        end
    }

    int f2()
    {
        begin
            write("In B F2");
            return 1;
        end
    }
}

C extends B
{
    decl
        int f0();
        int f2();
        int f4();
    enddecl

    int f0()
    {
        begin
            write("In C F0");
            return 1;
        end
    }

    int f2()
    {
        begin
            write("In C F2");
            return 1;
        end
    }

    int f4()
    {
        begin
            write("In C F4");
            return 1;
        end
    }
}

endclass

decl
    A obj;
    A test_obj;
enddecl

int main()
{
    decl
        int temp, n;
    enddecl
    begin
        initialize();
        read(n);

        if (n < 0) then
            obj = new(A);
        else
            if (n == 0) then
                obj = new(B);
            else
                if (n > 0) then
                    obj = new(C);
                endif;
            endif;
        endif;

        test_obj = obj;
        write(test_obj.f0());
        return 1;
    end
}