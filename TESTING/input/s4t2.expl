decl
  int n;
  int i, j, t;
  int a[20];
enddecl

int main()
{
decl
enddecl
  begin
    read(n);
    i = 0;
    while (i < n) do
      read(a[i]);
      i = i + 1;
    endwhile;

    i = 0;
    while (i < (n - 1)) do
      j = 0;
      while (j < (n - i - 1)) do
        if (a[j] > a[j + 1]) then
          t = a[j];
          a[j] = a[j + 1];
          a[j + 1] = t;
        endif;
        j = j + 1;
      endwhile;
      i = i + 1;
    endwhile;

    i = 0;
    while (i < n) do
      write(a[i]);
      i = i + 1;
    endwhile;
  end
}
